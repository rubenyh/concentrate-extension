{
  "name": "reels-shorts-blocker",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension that blocks Instagram Reels and YouTube Shorts.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs --zip",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
