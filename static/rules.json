  },
  {
    "id": 2,
    "priority": 1,
    "action": {
      "type": "redirect",
      "redirect": { "extensionPath": "/blocked.html?from=www.instagram.com" }
    },
    "condition": {
      "regexFilter": "^https?://www\\.instagram\\.com/([^/?#]+/)?reels?([/?#].*)?$",
