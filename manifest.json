{
  "manifest_version": 3,
  "name": "Reels & Shorts Blocker",
  "version": "0.1.0",
  "description": "Blocks Instagram Reels and YouTube Shorts while keeping the rest of both sites usable.",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "homepage_url": "https://github.com/rubenyh/concentrate-extension",
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://youtube.com/*",
    "https://www.instagram.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [{ "id": "block_routes", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*", "https://youtube.com/*"],
      "css": ["youtube.css"],
      "js": ["youtube.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "css": ["instagram.css"],
      "js": ["instagram.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://youtube.com/*",
        "https://www.instagram.com/*"
      ]
    }
  ]
}
